<UserControl
    x:Class="Jabasoft.Brug.App.Controls.Paneel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Een lila kader met donkergele titelbalk en vrije inhoud, vier ronde hoeken.
         Rechts in de balk past een korte toevoeging (een aantal, een status).
         Zelfde vorm als Infoblok, maar met eigen inhoud in plaats van een
         regel tekst. -->
    <Border BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="{StaticResource RegionBorderThickness}"
            CornerRadius="12,12,12,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{ThemeResource AccentBrushDark}"
                    CornerRadius="{StaticResource RegionBorderInnerRadius}"
                    Padding="14,5,14,5">
                <Grid>
                    <TextBlock Text="{x:Bind Titel, Mode=OneWay}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="Bold"
                               CharacterSpacing="120"
                               Foreground="{ThemeResource AccentForegroundBrush}" />
                    <TextBlock Text="{x:Bind Rechts, Mode=OneWay}"
                               HorizontalAlignment="Right"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="Bold"
                               CharacterSpacing="120"
                               Foreground="{ThemeResource AccentForegroundBrush}" />
                </Grid>
            </Border>

            <ContentPresenter Grid.Row="1"
                              Margin="14,12,14,14"
                              Content="{x:Bind Inhoud, Mode=OneWay}"
                              HorizontalContentAlignment="Stretch" />
        </Grid>
    </Border>
</UserControl>
