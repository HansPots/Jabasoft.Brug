<UserControl
    x:Class="Jabasoft.Brug.App.Controls.Kengetal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Een getal dat je in een oogopslag wilt zien: gekleurde balk links,
         label erboven, de waarde groot. -->
    <Grid ColumnSpacing="12" Height="76">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{x:Bind Kleur, Mode=OneWay}" CornerRadius="7,0,0,7" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource LabelStijl}" />
            <TextBlock Text="{x:Bind Waarde, Mode=OneWay}"
                       FontSize="{StaticResource FontSizeBig}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
