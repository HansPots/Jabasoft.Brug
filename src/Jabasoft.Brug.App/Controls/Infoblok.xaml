<UserControl
    x:Class="Jabasoft.Brug.App.Controls.Infoblok"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Een kader met een lila titelbalk, zoals de infoblokken in de header
         van Jabasoft.App. In fase 1 alleen titel en een regel tekst. -->
    <Border BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="{StaticResource RegionBorderThickness}"
            CornerRadius="{StaticResource RadiusLarge}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{ThemeResource BorderBrush}"
                    CornerRadius="{StaticResource RegionBorderInnerRadius}"
                    Padding="12,4,12,4">
                <TextBlock Text="{x:Bind Titel, Mode=OneWay}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="Bold"
                           CharacterSpacing="120"
                           Foreground="{ThemeResource AccentForegroundBrush}" />
            </Border>

            <TextBlock Grid.Row="1"
                       Text="{x:Bind Tekst, Mode=OneWay}"
                       Margin="12,10,12,10"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{ThemeResource TextMutedBrush}"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
