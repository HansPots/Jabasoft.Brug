<UserControl
    x:Class="Jabasoft.Brug.App.Controls.Waardeveld"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Een regel "label ... waarde": label links, waarde rechts. -->
    <Grid ColumnSpacing="12" Padding="0,3,0,3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource LabelStijl}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{x:Bind Waarde, Mode=OneWay}"
                   Style="{StaticResource WaardeStijl}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
    </Grid>
</UserControl>
