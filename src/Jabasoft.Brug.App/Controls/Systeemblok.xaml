<UserControl
    x:Class="Jabasoft.Brug.App.Controls.Systeemblok"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Blok 2 in de header: de pc. Zelfde opbouw als het tokenblok: bovenaan
        het belangrijkste getal groot in oranje (VRAM, want dat bepaalt wat
        er aan modellen past), daaronder drie regels: de videokaart
        (belasting en temperatuur), CPU en RAM. Elke 2 seconden bijgewerkt.
    -->
    <Border BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="{StaticResource RegionBorderThickness}"
            CornerRadius="{StaticResource RadiusLarge}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{ThemeResource BorderBrush}"
                    CornerRadius="{StaticResource RegionBorderInnerRadius}"
                    Padding="12,4,12,4">
                <TextBlock Text="SYSTEEM"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="Bold"
                           CharacterSpacing="120"
                           Foreground="{ThemeResource AccentForegroundBrush}" />
            </Border>

            <Grid Grid.Row="1" Margin="12,6,12,8" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="vram"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="Vram" Grid.Column="1"
                           Text="—"
                           FontSize="{StaticResource FontSizeBig}"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />

                <TextBlock x:Name="KaartNaam" Grid.Row="1" Text="GPU" Style="{StaticResource TokenModelStijl}" />
                <TextBlock x:Name="KaartWaarde" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource TokenWaardeStijl}" />
                <TextBlock Grid.Row="2" Text="CPU" Style="{StaticResource TokenModelStijl}" />
                <TextBlock x:Name="CpuWaarde" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource TokenWaardeStijl}" />
                <TextBlock Grid.Row="3" Text="RAM" Style="{StaticResource TokenModelStijl}" />
                <TextBlock x:Name="RamWaarde" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource TokenWaardeStijl}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
