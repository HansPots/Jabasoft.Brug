<UserControl
    x:Class="Jabasoft.Brug.App.Controls.Tokenblok"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Het tokenblok uit Jabasoft.App: het totaal groot in oranje, daaronder
        de drie zwaarste modellen. De cijfers komen van de broker
        (GET /api/usage/models), niet rechtstreeks uit de database: die
        verbinding ligt op een plek.
    -->
    <Border BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="{StaticResource RegionBorderThickness}"
            CornerRadius="{StaticResource RadiusLarge}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{ThemeResource BorderBrush}"
                    CornerRadius="{StaticResource RegionBorderInnerRadius}"
                    Padding="12,4,12,4">
                <TextBlock Text="TOKENS"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="Bold"
                           CharacterSpacing="120"
                           Foreground="{ThemeResource AccentForegroundBrush}" />
            </Border>

            <Grid Grid.Row="1" Margin="12,6,12,8" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="tokens totaal"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="Totaal" Grid.Column="1"
                           Text="—"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />

                <TextBlock x:Name="Model1" Grid.Row="1" Style="{StaticResource TokenModelStijl}" />
                <TextBlock x:Name="Waarde1" Grid.Row="1" Grid.Column="1" Style="{StaticResource TokenWaardeStijl}" />
                <TextBlock x:Name="Model2" Grid.Row="2" Style="{StaticResource TokenModelStijl}" />
                <TextBlock x:Name="Waarde2" Grid.Row="2" Grid.Column="1" Style="{StaticResource TokenWaardeStijl}" />
                <TextBlock x:Name="Model3" Grid.Row="3" Style="{StaticResource TokenModelStijl}" />
                <TextBlock x:Name="Waarde3" Grid.Row="3" Grid.Column="1" Style="{StaticResource TokenWaardeStijl}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
