<UserControl
    x:Class="Jabasoft.Brug.App.Controls.Verloop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        De vijf stappen van een verzoek in de broker, als balk:
        ontvangen - wachtrij - model laden - prompt verwerken - genereren.
        Afgeronde stappen zijn lila, de huidige oranje, de rest donker.
        Welke stap de huidige is, zet je met Stap (0 t/m 4).
    -->
    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Stap0" Grid.Column="0" Margin="0,0,3,0" CornerRadius="6,0,0,6" />
        <Border x:Name="Stap1" Grid.Column="1" Margin="0,0,3,0" CornerRadius="0,0,0,0" />
        <Border x:Name="Stap2" Grid.Column="2" Margin="0,0,3,0" CornerRadius="0,0,0,0" />
        <Border x:Name="Stap3" Grid.Column="3" Margin="0,0,3,0" CornerRadius="0,0,0,0" />
        <Border x:Name="Stap4" Grid.Column="4" CornerRadius="0,6,6,0" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="ONTVANGEN" Style="{StaticResource LabelStijl}" FontSize="10" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="WACHTRIJ" Style="{StaticResource LabelStijl}" FontSize="10" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="MODEL LADEN" Style="{StaticResource LabelStijl}" FontSize="10" />
        <TextBlock Grid.Row="1" Grid.Column="3" Text="PROMPT" Style="{StaticResource LabelStijl}" FontSize="10" />
        <TextBlock Grid.Row="1" Grid.Column="4" Text="GENEREREN" Style="{StaticResource LabelStijl}" FontSize="10" />
    </Grid>
</UserControl>
