<UserControl
    x:Class="Jabasoft.Brug.App.Paginas.Hoofdscherm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Het hoofdscherm: de brug, vullend en zonder randen. UniformToFill
        houdt de verhouding vast (2400x876, bijna gelijk aan het inhoudsvlak)
        en snijdt hooguit een randje weg in plaats van uit te rekken.
    -->
    <Grid>
        <Image x:Name="Brug"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
    </Grid>
</UserControl>
