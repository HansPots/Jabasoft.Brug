<UserControl
    x:Class="Jabasoft.Brug.App.Paginas.LegePagina"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Een scherm dat nog gevuld moet worden: titel, wat er komt, en in welke fase. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock x:Name="TitelTekst"
                       FontSize="{StaticResource FontSizeHeading}"
                       FontWeight="SemiBold"
                       CharacterSpacing="60"
                       Foreground="{ThemeResource TextPrimaryBrush}" />

            <Border BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="{StaticResource RegionBorderThickness}"
                    CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel>
                    <Border Background="{ThemeResource BorderBrush}"
                            CornerRadius="{StaticResource RegionBorderInnerRadius}"
                            Padding="14,6,14,6">
                        <TextBlock x:Name="FaseTekst"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontWeight="Bold"
                                   CharacterSpacing="120"
                                   Foreground="{ThemeResource AccentForegroundBrush}" />
                    </Border>
                    <TextBlock x:Name="OmschrijvingTekst"
                               Margin="14,12,14,14"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{ThemeResource Text01Brush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
