<UserControl
    x:Class="Jabasoft.Brug.App.Paginas.Broker.Health"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jabasoft.Brug.App.Controls">

    <!--
        Broker > Health. Alleen vormgeving: de statussen hieronder zijn
        voorbeelden. In fase 2 komen ze uit de health-checks van
        Jabasoft.Base (HealthMonitor, AiBrokerHealthCheck enz.).

        Bovenaan een band met de totaalstand, daaronder een kaart per
        onderdeel. Kleur van het bolletje: groen = in orde, oranje = in rust
        of bezig, rood = fout (dezelfde kleuren als de SYSTEM HEALTH-pil).
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" Spacing="24">

            <Grid>
                <TextBlock Text="HEALTH" Style="{StaticResource PaginaTitelStijl}" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{ThemeResource TextMutedBrush}" CornerRadius="10,10,10,0">
                    <TextBlock Text="VOORBEELDWEERGAVE · NOG GEEN LIVE GEGEVENS" Style="{StaticResource PilletjeTekstStijl}" />
                </Border>
            </Grid>

            <!-- Totaalstand -->
            <Border Background="{ThemeResource HealthOkBrush}" CornerRadius="22,22,22,0" Height="44">
                <Grid Margin="20,0,20,0">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Ellipse Width="14" Height="14" Fill="{ThemeResource AccentForegroundBrush}" />
                        <TextBlock Text="ALLES BEREIKBAAR · 1 ONDERDEEL IN RUST"
                                   FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold" CharacterSpacing="120"
                                   Foreground="{ThemeResource AccentForegroundBrush}" />
                    </StackPanel>
                    <TextBlock Text="LAATST GECONTROLEERD 15:42:10"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" CharacterSpacing="100"
                               Foreground="{ThemeResource AccentForegroundBrush}" />
                </Grid>
            </Border>

            <!-- Een kaart per onderdeel -->
            <Grid ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:Paneel Grid.Row="0" Grid.Column="0" Titel="BROKER" Rechts=":5310">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                            <Ellipse Width="12" Height="12" Fill="{ThemeResource HealthOkBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Online" Style="{StaticResource WaardeStijl}" FontWeight="SemiBold" />
                        </StackPanel>
                        <controls:Waardeveld Label="REACTIETIJD" Waarde="3 ms" />
                        <controls:Waardeveld Label="DRAAIT SINDS" Waarde="3 u 12 min" />
                        <controls:Waardeveld Label="WACHTRIJ" Waarde="2 verzoeken" />
                    </StackPanel>
                </controls:Paneel>

                <controls:Paneel Grid.Row="0" Grid.Column="1" Titel="DATABASE" Rechts="LOCALDB">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                            <Ellipse Width="12" Height="12" Fill="{ThemeResource HealthOkBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Bereikbaar" Style="{StaticResource WaardeStijl}" FontWeight="SemiBold" />
                        </StackPanel>
                        <controls:Waardeveld Label="INSTANTIE" Waarde="(localdb)\MSSQLLocalDB" />
                        <controls:Waardeveld Label="DATABASES" Waarde="Broker · Brug" />
                        <controls:Waardeveld Label="REACTIETIJD" Waarde="4 ms" />
                    </StackPanel>
                </controls:Paneel>

                <controls:Paneel Grid.Row="0" Grid.Column="2" Titel="AI-SERVER" Rechts="LM STUDIO">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                            <Ellipse Width="12" Height="12" Fill="{ThemeResource HealthOkBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Bereikbaar" Style="{StaticResource WaardeStijl}" FontWeight="SemiBold" />
                        </StackPanel>
                        <controls:Waardeveld Label="ADRES" Waarde="127.0.0.1:1234" />
                        <controls:Waardeveld Label="REACTIETIJD" Waarde="18 ms" />
                        <controls:Waardeveld Label="OLLAMA" Waarde="niet in gebruik" />
                    </StackPanel>
                </controls:Paneel>

                <controls:Paneel Grid.Row="1" Grid.Column="0" Titel="MODELLEN" Rechts="1 GELADEN">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                            <Ellipse Width="12" Height="12" Fill="{ThemeResource HealthOkBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Klaar voor gebruik" Style="{StaticResource WaardeStijl}" FontWeight="SemiBold" />
                        </StackPanel>
                        <controls:Waardeveld Label="CHAT" Waarde="qwen3.6-35b-a3b" />
                        <controls:Waardeveld Label="CONTEXT" Waarde="65.536" />
                        <controls:Waardeveld Label="EMBEDDING" Waarde="nomic-embed-text" />
                    </StackPanel>
                </controls:Paneel>

                <controls:Paneel Grid.Row="1" Grid.Column="1" Titel="BEELDSERVICE" Rechts=":5330">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                            <Ellipse Width="12" Height="12" Fill="{ThemeResource HealthBusyBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="In rust" Style="{StaticResource WaardeStijl}" FontWeight="SemiBold" />
                        </StackPanel>
                        <controls:Waardeveld Label="START" Waarde="bij de eerste beeldopdracht" />
                        <controls:Waardeveld Label="BEELDMODEL" Waarde="Juggernaut XL" />
                        <controls:Waardeveld Label="VIDEOMODEL" Waarde="LTX-Video 0.9.1" />
                    </StackPanel>
                </controls:Paneel>

                <controls:Paneel Grid.Row="1" Grid.Column="2" Titel="GPU" Rechts="RTX 4070 SUPER">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                            <Ellipse Width="12" Height="12" Fill="{ThemeResource HealthOkBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Beurt: taalmodellen" Style="{StaticResource WaardeStijl}" FontWeight="SemiBold" />
                        </StackPanel>
                        <controls:Waardeveld Label="VRAM" Waarde="9,8 / 12 GB" />
                        <Grid Height="10" Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="98*" />
                                <ColumnDefinition Width="22*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{ThemeResource AccentBrush}" CornerRadius="5,0,0,5" />
                            <Border Grid.Column="1" Background="#2A2A3A" CornerRadius="0,5,5,0" />
                        </Grid>
                        <controls:Waardeveld Label="TWEEDE KAART" Waarde="nog niet aanwezig" />
                    </StackPanel>
                </controls:Paneel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
