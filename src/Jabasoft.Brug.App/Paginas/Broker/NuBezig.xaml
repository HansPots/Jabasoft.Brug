<UserControl
    x:Class="Jabasoft.Brug.App.Paginas.Broker.NuBezig"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jabasoft.Brug.App.Controls">

    <!--
        Broker > Nu bezig. Alleen vormgeving: alle getallen en namen hieronder
        zijn voorbeelden. In fase 3 en 4 komen ze live uit de broker.

        Opbouw van boven naar beneden:
        1. vier kengetallen (lopend, wachtrij, wie de GPU heeft, snelheid);
        2. links de lopende verzoeken, elk met zijn verloop en cijfers;
           rechts de GPU-beurt en de wachtrij, met waarom iets wacht.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" Spacing="24">

            <!-- Geen paginatitel: het menu laat al zien waar je bent. -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{ThemeResource TextMutedBrush}" CornerRadius="10,10,10,0">
                <TextBlock Text="VOORBEELDWEERGAVE · NOG GEEN LIVE GEGEVENS" Style="{StaticResource PilletjeTekstStijl}" />
            </Border>

            <!-- 1. Kengetallen -->
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:Kengetal Grid.Column="0" Label="LOPEND" Waarde="2" Kleur="{ThemeResource AccentBrush}" />
                <controls:Kengetal Grid.Column="1" Label="IN DE WACHTRIJ" Waarde="2" Kleur="{ThemeResource TextMutedBrush}" />
                <controls:Kengetal Grid.Column="2" Label="GPU-BEURT" Waarde="Taalmodellen" Kleur="{ThemeResource HeaderSideGradientBrush}" />
                <controls:Kengetal Grid.Column="3" Label="SNELHEID" Waarde="38 tok/s" Kleur="{ThemeResource BorderBrush}" />
            </Grid>

            <!-- 2. Verzoeken links, GPU en wachtrij rechts -->
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="16">
                    <TextBlock Text="LOPENDE VERZOEKEN" Style="{StaticResource SectieKopStijl}" />

                    <controls:Paneel Titel="VERZOEK #1042" Rechts="GENEREREN · 00:12">
                        <Grid ColumnSpacing="24" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{ThemeResource AccentBrushLight}" CornerRadius="10,10,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="GOOSE" Style="{StaticResource PilletjeTekstStijl}" />
                                </Border>
                                <TextBlock Text="qwen3.6-35b-a3b" Style="{StaticResource WaardeStijl}" VerticalAlignment="Center" />
                                <TextBlock Text="LM Studio · context 65.536" Style="{StaticResource LabelStijl}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource MenuKnopStijl}" Height="32" FontSize="{StaticResource FontSizeSmall}"
                                    CornerRadius="14,14,14,0" Padding="14,0,14,0" Background="{ThemeResource TextMutedBrush}">
                                <TextBlock Text="ANNULEREN" CharacterSpacing="100" />
                            </Button>

                            <controls:Verloop Grid.Row="1" Grid.ColumnSpan="2" Stap="4" />

                            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:Waardeveld Grid.Column="0" Label="WACHTTIJD" Waarde="0,2 s" />
                                <controls:Waardeveld Grid.Column="1" Label="EERSTE TOKEN" Waarde="1,4 s" />
                                <controls:Waardeveld Grid.Column="2" Label="SNELHEID" Waarde="38 tok/s" />
                                <controls:Waardeveld Grid.Column="3" Label="TOKENS IN / UIT" Waarde="6.210 / 412" />
                            </Grid>
                        </Grid>
                    </controls:Paneel>

                    <controls:Paneel Titel="VERZOEK #1043" Rechts="PROMPT 64% · 00:04">
                        <Grid ColumnSpacing="24" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{ThemeResource AccentBrush}" CornerRadius="10,10,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="AI STUDIO" Style="{StaticResource PilletjeTekstStijl}" />
                                </Border>
                                <TextBlock Text="qwen3.6-35b-a3b" Style="{StaticResource WaardeStijl}" VerticalAlignment="Center" />
                                <TextBlock Text="meeloper op hetzelfde model" Style="{StaticResource LabelStijl}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource MenuKnopStijl}" Height="32" FontSize="{StaticResource FontSizeSmall}"
                                    CornerRadius="14,14,14,0" Padding="14,0,14,0" Background="{ThemeResource TextMutedBrush}">
                                <TextBlock Text="ANNULEREN" CharacterSpacing="100" />
                            </Button>

                            <controls:Verloop Grid.Row="1" Grid.ColumnSpan="2" Stap="3" />

                            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:Waardeveld Grid.Column="0" Label="WACHTTIJD" Waarde="0,0 s" />
                                <controls:Waardeveld Grid.Column="1" Label="EERSTE TOKEN" Waarde="—" />
                                <controls:Waardeveld Grid.Column="2" Label="SNELHEID" Waarde="—" />
                                <controls:Waardeveld Grid.Column="3" Label="TOKENS IN / UIT" Waarde="18.940 / 0" />
                            </Grid>
                        </Grid>
                    </controls:Paneel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <TextBlock Text="GPU" Style="{StaticResource SectieKopStijl}" />

                    <controls:Paneel Titel="GPU-BEURT" Rechts="RTX 4070 SUPER">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Width="12" Height="12" Fill="{ThemeResource HealthOkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Taalmodellen (LM Studio)" Style="{StaticResource WaardeStijl}" FontWeight="SemiBold" />
                            </StackPanel>
                            <controls:Waardeveld Label="SINDS" Waarde="15:41:08" />
                            <controls:Waardeveld Label="GELADEN" Waarde="qwen3.6-35b-a3b" />

                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="VRAM" Style="{StaticResource LabelStijl}" />
                                    <TextBlock Text="9,8 / 12 GB" Style="{StaticResource WaardeStijl}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Height="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="98*" />
                                        <ColumnDefinition Width="22*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource AccentBrush}" CornerRadius="6,0,0,6" />
                                    <Border Grid.Column="1" Background="#2A2A3A" CornerRadius="0,6,6,0" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </controls:Paneel>

                    <TextBlock Text="WACHTRIJ" Style="{StaticResource SectieKopStijl}" Margin="0,8,0,0" />

                    <controls:Paneel Titel="#1044 · IMAGEFUNN" Rechts="00:45">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Film &quot;De vuurtoren&quot; · 6 scènes" Style="{StaticResource WaardeStijl}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="10" Height="10" Fill="{ThemeResource HealthBusyBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Wacht op de GPU voor zich alleen" Style="{StaticResource LabelStijl}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </controls:Paneel>

                    <controls:Paneel Titel="#1045 · HERMES" Rechts="00:12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="qwen3.6-35b-a3b · chat" Style="{StaticResource WaardeStijl}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="10" Height="10" Fill="{ThemeResource HealthBusyBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Wacht achter ImageFunn" Style="{StaticResource LabelStijl}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </controls:Paneel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
