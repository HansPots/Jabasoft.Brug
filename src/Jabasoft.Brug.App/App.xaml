<Application
    x:Class="Jabasoft.Brug.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- De standaardstijlen van WinUI eerst; daarna het eigen thema,
                     dat wint waar het dezelfde naam gebruikt. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Thema/Lcars.xaml" />
                <ResourceDictionary Source="ms-appx:///Thema/Maten.xaml" />
                <ResourceDictionary Source="ms-appx:///Thema/Stijlen.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
