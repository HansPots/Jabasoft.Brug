<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Maten en lettertypen, gelijk aan Typography.xaml uit
        Stylebook.Components. Een genoemde maat kiezen in plaats van overal
        losse getallen.
    -->

    <Thickness x:Key="SpaceXSmall">4,4,4,4</Thickness>
    <Thickness x:Key="SpaceSmall">8,8,8,8</Thickness>
    <Thickness x:Key="SpaceMedium">16,16,16,16</Thickness>
    <Thickness x:Key="SpaceLarge">24,24,24,24</Thickness>

    <!-- De ruimte tussen de vijf blokken van Basis. Elk blok geeft ruimte aan
         zijn linker- en bovenkant; de rand rechts en onder komt van de
         opvulling om het geheel. -->
    <x:Double x:Key="RegionGapSize">6</x:Double>
    <Thickness x:Key="RegionGapLeftTopThickness">6,6,0,0</Thickness>
    <Thickness x:Key="RegionGapEndThickness">0,0,6,6</Thickness>

    <Thickness x:Key="RegionBorderThickness">3,3,3,3</Thickness>
    <!-- Buitenstraal (12) min de randdikte (3), voor een balk binnen een kader. -->
    <CornerRadius x:Key="RegionBorderInnerRadius">9,9,0,0</CornerRadius>

    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <!-- Iconen: het lettertype dat Windows 11 zelf meebrengt. -->
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons</FontFamily>
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeTitle">18</x:Double>
    <x:Double x:Key="FontSizeHeading">28</x:Double>

    <!-- Vaste maten van de schil. -->
    <x:Double x:Key="HeaderHeight">210</x:Double>
    <x:Double x:Key="FooterHeight">24</x:Double>
    <x:Double x:Key="MenuWidth">256</x:Double>
    <x:Double x:Key="ActionWidth">48</x:Double>

</ResourceDictionary>
