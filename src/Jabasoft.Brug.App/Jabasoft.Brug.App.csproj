<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Jabasoft.Brug - de ene app waarin alle Jabasoft-onderdelen samenkomen.
    WinUI 3, unpackaged: een gewone map met een exe, geen MSIX-pakket en
    geen certificaat. De Windows App SDK gaat mee in de uitvoermap
    (WindowsAppSDKSelfContained), zodat er op de pc geen losse runtime
    geinstalleerd hoeft te worden.

    Versie: elke wijziging aan de Brug verhoogt het laatste cijfer met 1.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Jabasoft.Brug.App</RootNamespace>
    <AssemblyName>Jabasoft.Brug</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>2.0.0.18</Version>
    <Product>Jabasoft.Brug</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Afbeeldingen\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
