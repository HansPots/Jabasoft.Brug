<UserControl
    x:Class="Jabasoft.Brug.App.Regios.Actie.Actiebalk"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        De actiebalk rechts (48 breed). Elke knop heeft een VASTE plek en
        staat er altijd; hij springt nooit weg of verschuift. Heeft hij op
        het open scherm geen functie, dan is hij zacht (doorzichtig) en niet
        aan te klikken; heeft hij wel een functie, dan volle kleur.

        - Boven: Broker starten. Alleen actief op de broker-schermen, en
          alleen als de broker niet bereikbaar is.
        - Onder: Verversen. Alleen actief op een scherm dat kan verversen
          (IVerversbaar).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="{ThemeResource BorderBrush}" CornerRadius="4,18,18,4" Opacity="0.25" />

        <Button x:Name="StartKnop"
                Grid.Row="0"
                Margin="0,12,0,0"
                Style="{StaticResource ActieKnopStijl}"
                IsEnabled="False"
                Click="StartKnop_Click"
                ToolTipService.ToolTip="Broker starten">
            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE768;" FontSize="16" />
        </Button>

        <Button x:Name="VerversKnop"
                Grid.Row="2"
                Margin="0,0,0,12"
                Style="{StaticResource ActieKnopStijl}"
                IsEnabled="False"
                Click="VerversKnop_Click"
                ToolTipService.ToolTip="Verversen">
            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE72C;" FontSize="16" />
        </Button>
    </Grid>
</UserControl>
