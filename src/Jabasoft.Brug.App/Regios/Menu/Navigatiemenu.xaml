<UserControl
    x:Class="Jabasoft.Brug.App.Regios.Menu.Navigatiemenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Het menu links. De knoppen staan niet hier maar worden opgebouwd uit
        Menukaart (zie Navigatiemenu.xaml.cs): een onderdeel met kinderen
        klapt uit, de rest opent een scherm.

        Het menu navigeert niet zelf; het meldt via het event Gekozen welk
        onderdeel gekozen is, en MainWindow beslist wat er getoond wordt.

        De knoppen staan in de *-rij, de versie in de Auto-rij eronder, zodat
        die onderaan blijft staan hoe hoog het venster ook is.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                Background="{ThemeResource TextMutedBrush}"
                CornerRadius="18,0,0,18" />

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Knoppen" Margin="16,24,16,24" Spacing="8" />
        </ScrollViewer>

        <Border Grid.Row="1"
                Margin="16,0,16,16"
                Background="{ThemeResource BackgroundBrush}"
                CornerRadius="12,12,12,12"
                Padding="14,6,14,6">
            <TextBlock x:Name="VersieTekst"
                       FontSize="{StaticResource FontSizeTiny}"
                       FontWeight="Bold"
                       CharacterSpacing="120"
                       Foreground="{ThemeResource AccentBrush}" />
        </Border>
    </Grid>
</UserControl>
