<UserControl
    x:Class="Jabasoft.Brug.App.Regios.Footer.Statusbalk"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        De footer: vijf statuspillen naast elkaar, zoals in Jabasoft.App.
        In fase 1 tonen ze nog geen metingen (een streepje); in fase 2 komen
        health, CPU, RAM en VRAM uit Jabasoft.Base. De laatste pil toont de
        versie van de Brug.
    -->
    <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{ThemeResource AccentBrush}" CornerRadius="12,12,12,12">
            <!-- Het bolletje toont de broker: groen = bereikbaar, oranje = bezig
                 met starten, rood = niet bereikbaar. Zwarte rand, zodat groen
                 en oranje niet wegvallen tegen het oranje van de pil. -->
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="HealthBolletje"
                         Width="12" Height="12" Margin="12,0,0,0"
                         Fill="{ThemeResource AccentForegroundBrush}"
                         Stroke="{ThemeResource AccentForegroundBrush}" StrokeThickness="2"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="HealthTekst" Style="{StaticResource PilTekstStijl}" Margin="8,0,12,0" Text="SYSTEM HEALTH  —" />
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{ThemeResource BorderBrush}" CornerRadius="12,12,12,12">
            <TextBlock x:Name="CpuTekst" Style="{StaticResource PilTekstStijl}" Text="CPU  —" />
        </Border>
        <Border Grid.Column="2" Background="{ThemeResource TextMutedBrush}" CornerRadius="12,12,12,12">
            <TextBlock x:Name="RamTekst" Style="{StaticResource PilTekstStijl}" Text="RAM  —" />
        </Border>
        <Border Grid.Column="3" Background="{ThemeResource HeaderGradientMidBrush}" CornerRadius="12,12,12,12">
            <TextBlock x:Name="VramTekst" Style="{StaticResource PilTekstStijl}" Text="VRAM  —" />
        </Border>
        <Border Grid.Column="4" Background="{ThemeResource AccentBrushDark}" CornerRadius="12,12,12,12">
            <TextBlock x:Name="VersieTekst" Style="{StaticResource PilTekstStijl}" />
        </Border>
    </Grid>
</UserControl>
